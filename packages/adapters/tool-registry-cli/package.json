{
  "name": "@gonk/tool-registry-cli",
  "version": "0.3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gonk/scope": "workspace:*",
    "@gonk/tool-registry": "workspace:*",
    "@gonk/tool-orchestrator": "workspace:*"
  },
  "devDependencies": {
    "@standard-schema/spec": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "description": "CLI adapter — turns a ToolRegistry or Orchestrator into a binary where each tool is a subcommand.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightwork-dev/gonk.git",
    "directory": "packages/adapters/tool-registry-cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
