    "@gonk/scope": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gonk/scope": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Harness-agnostic typed tool definitions and secure dispatch with Standard Schema validation, composed invocation, authorization, approval, metrics, and audit receipts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightwork-dev/gonk.git",
    "directory": "packages/core/tool-registry"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
