{
  "name": "@gonk/tool-orchestrator",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./meta-tools": {
      "types": "./dist/meta-tools.d.ts",
      "import": "./dist/meta-tools.js"
    },
    "./explain": {
      "types": "./dist/explain.d.ts",
      "import": "./dist/explain.js"
    }
