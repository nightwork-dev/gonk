{
  "name": "@gonk/store",
  "version": "0.0.19",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gonk/scope": "workspace:*",
    "@gonk/utils": "workspace:*",
    "@mirk/store": "catalog:",
    "better-sqlite3": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Backing-agnostic scoped store for the gonk harness: KV, blob, append-log, and vector-KNN stores resolved by (scope-tier, namespace) through @gonk/scope, never a caller-assembled path. Default pure-filesystem backend behind a swappable StoreBackend SPI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightwork-dev/gonk.git",
    "directory": "packages/core/store"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
