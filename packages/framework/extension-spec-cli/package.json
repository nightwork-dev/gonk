{
  "name": "@gonk/extension-spec-cli",
  "version": "0.0.11",
  "type": "module",
  "description": "CLI runtime for @gonk/extension-spec — turns an ExtensionSpec into a registered CLI extension (subcommands, auto-generated set/preset/config, interactive settings prompts).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@inquirer/prompts": "catalog:",
    "@gonk/extension-spec": "workspace:*",
    "@gonk/extension-spec-pi": "workspace:*",
    "@gonk/scope": "workspace:*",
    "@gonk/tool-registry": "workspace:*",
    "@gonk/tool-registry-pi": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightwork-dev/gonk.git",
    "directory": "packages/framework/extension-spec-cli"
  }
}
